    {
      "id": "53baaa23-2d6d-4057-82ca-e5d41e2fe2b8",
      "layout": "navy-ribbon",
      "eyebrow": "",
      "title": "Your browser can save",
      "body": "It may keep a copy of a web response after the first visit.",
      "items": [],
      "image": "",
      "image2": "",
      "titleSize": 64,
      "texture": true,
      "swipe": true
    },
    {
      "id": "830f3826-5a77-4f35-8056-1f92898bbbbb",
      "layout": "navy-ribbon",
      "eyebrow": "",
      "title": "That copy is a cache",
      "body": "A cache holds data that may be useful again soon.",
      "items": [],
      "image": "",
      "image2": "",
      "titleSize": 64,
      "texture": true,
      "swipe": true
    },
    {
      "id": "20decf60-801b-44ca-9032-556ca08662d8",
      "layout": "navy-ribbon",
      "eyebrow": "",
      "title": "Reuse saves work",
      "body": "If the saved response is usable, the browser may skip a full download.",
      "items": [],
      "image": "",
      "image2": "",
      "titleSize": 64,
      "texture": true,
      "swipe": true
    },
    {
